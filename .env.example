# ==============================================================================
# Email Automation & Reminder System - Configuration Template (.env.example)
# DO NOT store real passwords in this file. Copy to .env and set your credentials.
# ==============================================================================

# SMTP Server Settings (Standard STARTTLS on port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password

# Default Sender Identity
SENDER_NAME=Acme Enterprise Reminders
SENDER_EMAIL=your_email@gmail.com

# Safety Defaults & Throttling
DRY_RUN_DEFAULT=True
MAX_EMAILS_PER_BATCH=50
RATE_LIMIT_DELAY_SECONDS=1.0
MAX_RETRIES=3
LOG_LEVEL=INFO
